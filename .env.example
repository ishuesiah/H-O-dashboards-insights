# Authentication (Google OAuth - same client as post-purchase-survey;
# add <APP_URL>/api/auth/google-callback to its authorized redirect URIs)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Optional: defaults to hemlockandoak.com
# ALLOWED_EMAIL_DOMAIN=hemlockandoak.com
# Optional: overrides the origin derived from request headers
# APP_URL=https://your-deployment.vercel.app
JWT_SECRET=your_random_32_byte_secret

# External APIs
REFERRAL_API_URL=https://referral-web-app-k02k2.kinsta.app
ADDRESS_WEBHOOK_URL=https://address-issue-webhook-bufx1.kinsta.app
CUSTOMIZATION_WEBHOOK_URL=https://customization-webhook-b6ou1.kinsta.app

# API Keys
WEBHOOK_API_KEY=your_shared_api_key
REFERRAL_API_SECRET=your_referral_dashboard_secret
